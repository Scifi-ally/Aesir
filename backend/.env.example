# Copy this file to .env for local development. Never commit .env.

DATABASE_URL=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3001
NODE_ENV=development
FULL_MARKET_SCAN=false
FRONTEND_APP_URL=http://localhost:5173
ALLOW_TUNNELS=false
UPSTOX_PHONE=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
PORTABLE_PGPASSWORD=
UPSTOXBOT_SECRET_KEY=
UPSTOXBOT_ADMIN_TOKEN=
UPSTOXBOT_RATE_LIMIT_MAX=60
AI_SERVICE_TOKEN=
LOG_LEVEL=info

# Runtime services and network boundaries
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Upstox data/instrument endpoints
UPSTOX_ACCESS_TOKEN=
UPSTOX_DATA_API_KEY=
UPSTOX_DATA_API_SECRET=
UPSTOX_INSTRUMENTS_URL=

# Intelligence, monitoring, and scan tuning
FEED_MAX_STOCKS=200
MAX_SCAN_STOCKS=200
MAX_TICKS_PER_STOCK=80
INTEL_MIN_UNIVERSE=50
INTEL_MAX_UNIVERSE=500
INTEL_MAX_CANDIDATES=100
INTEL_MAX_AI_OPPORTUNITIES=20
INTEL_MAX_TECHNICAL_SYMBOLS=50
INTEL_CANDLE_BUFFER=200
INTEL_FRONTEND_FLUSH_MS=1000
MONITORING_CYCLE_CONCURRENCY=4
MONITORING_MAX_STOCKS=50
MAX_SUGGESTIONS_PER_DAY=20
MIN_DAILY_TURNOVER_INR=10000000
UI_TICK_FLUSH_MS=250
MIMIR_RL_WEIGHT=1

# Safety and diagnostics
RATE_LIMIT_FAIL_CLOSED=true
STRICT_DATA_INTEGRITY=true
STRICT_REGIME_GATE=true
DIAGNOSE_SCAN_FAILURES=false
ENABLE_INTRADAY_WATCHLIST_ENRICHMENT=false
LOG_UNMONITORED_TICKS=false
LOG_UPSTOX_PAYLOADS=false
ELECTRON_DISABLE_SECURITY_WARNINGS=false
REPLIT_DEV_DOMAIN=

# Proxy and administrative access controls
TRUSTED_PROXIES=loopback
ALLOW_PRIVATE_SUBNET_ADMIN=false
ALLOW_ALL_ORIGINS=false
ALLOW_REMOTE_ADMIN=false

# AI inference budgets
AI_INFERENCE_TIMEOUT_MS=30000
AI_INFERENCE_PER_CANDIDATE_MS=500
AI_INFERENCE_TIMEOUT_CAP_MS=120000
